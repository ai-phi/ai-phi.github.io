---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import SessionArchiveCard from "@components/sessions/SessionArchiveCard.astro";
import SessionsNav from "@components/sessions/SessionsNav.astro";
import { ARCHIVE_FORMAT_LABELS, getArchiveSessionFormatKeys, type SessionEdition } from "@utils/sessionArchive";
import { SITE } from "@config";

interface Props {
  edition: SessionEdition;
  editions: SessionEdition[];
}
const { edition, editions } = Astro.props;
const current = edition.startYear === editions[0].startYear;
const hasCycles = edition.startYear >= 2026;
const cycles = edition.groups.filter(group => group.type === "cycle");
const formats = Object.entries(ARCHIVE_FORMAT_LABELS).filter(([key]) =>
  edition.sessions.some(session => getArchiveSessionFormatKeys(session).includes(key))
);
const sessionCount = (count: number) =>
  `${count} ${count === 1 ? "session" : "sessions"}`;
const description =
  "Explore ai-phi’s sessions by edition, from our first conversations in 2023 to the current programme.";
---

<Layout
  title={`${current ? "Sessions" : `${edition.label} (${edition.years})`} | ${
    SITE.title
  }`}
  description={description}
>
  <Header activeNav="sessions" />
  <main id="main-content" class="sessions-page" data-cycle-browser={hasCycles ? "true" : undefined}>
    <nav class="archive-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a><span aria-hidden="true">/</span>
      {
        current ? (
          <span aria-current="page">Sessions</span>
        ) : (
          <>
            <>
              <a href="/sessions/">Sessions</a>
              <span aria-hidden="true">/</span>
              <span aria-current="page">{edition.label}</span>
            </>
          </>
        )
      }
    </nav>

    <header class="page-heading">
      <p class="eyebrow">The ai-phi programme</p>
      <h1>Sessions</h1>
      <p class="page-introduction">{description}</p>
    </header>

    <nav aria-label="Choose an ai-phi edition" class="edition-nav">
      {
        editions.map((item, index) => (
          <a
            href={item.path}
            class:list={[
              "edition-link",
              { selected: item.startYear === edition.startYear },
            ]}
            aria-current={
              item.startYear === edition.startYear ? "page" : undefined
            }
          >
            <span class="edition-link-top">
              <>
                <strong>{item.label}</strong>
                <span aria-hidden="true">↗</span>
              </>
            </span>
            <span class="edition-years">{item.years}</span>
            <span class="edition-count">
              {sessionCount(item.sessions.length)}
              {index === 0 && <span class="current-label">Latest edition</span>}
            </span>
          </a>
        ))
      }
    </nav>

    <header class="edition-heading">
      <p class="eyebrow">{current ? "Latest edition" : "From the archive"}</p>
      <h2>{edition.label} <span>({edition.years})</span></h2>
      <p class="edition-introduction">{edition.introduction}</p>
      <p class="edition-summary">
        {sessionCount(edition.sessions.length)}
        <span aria-hidden="true">·</span>
        {edition.groups.map(group => group.title).join(" · ")}
      </p>
    </header>

    {hasCycles ? (
      <div class="programme-browser">
        <div class="programme-filters" hidden>
          <label>
            <span>Thematic cycle</span>
            <select data-cycle-filter>
              <option value="all">All cycles</option>
              {cycles.map(group => <option value={group.id}>{group.title}</option>)}
              {edition.groups.some(group => group.type !== "cycle") && <option value="independent">Outside a cycle</option>}
            </select>
          </label>
          <label>
            <span>Format</span>
            <select data-format-filter>
              <option value="all">All formats</option>
              {formats.map(([key, label]) => <option value={key}>{label}</option>)}
            </select>
          </label>
          <button type="button" data-reset-filters hidden>Clear filters</button>
        </div>
        <p class="filter-status" role="status" aria-live="polite" aria-atomic="true" hidden></p>
        <p class="filter-empty" hidden>No sessions match this cycle and format yet. Try another combination or clear the filters.</p>
      </div>
    ) : edition.groups.length > 1 && (
      <nav class="group-nav" aria-label={`Groups in ${edition.label}`}>
        {edition.groups.map(group => (
          <a href={`#${group.id}`}>{group.title}<span>{group.sessions.length}</span></a>
        ))}
      </nav>
    )}

    <div class="edition-groups">
      {
        edition.groups.map(group => (
          <section
            id={group.id}
            class="archive-group"
            data-cycle={group.type === "cycle" ? group.id : "independent"}
            aria-labelledby={`${group.id}-heading`}
          >
            <div class="group-heading">
              <div>
                <p class="eyebrow">
                  {group.type === "cycle" ? "Cycle" : "Sessions"}
                </p>
                <h3 id={`${group.id}-heading`}>{group.title}</h3>
              </div>
              <span class="group-count">
                {sessionCount(group.sessions.length)}
              </span>
            </div>
            {group.description && (
              <p class="group-introduction">{group.description}</p>
            )}
            <ol class="session-list">
              {group.sessions.map(session => (
                <li data-session-formats={getArchiveSessionFormatKeys(session).join(" ")}>
                  <SessionArchiveCard
                    session={session}
                    featured={current && group.sessions.length === 1}
                  />
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </div>

    <aside class="cross-edition" aria-labelledby="cross-edition-heading">
      <h2 id="cross-edition-heading">Browse across editions</h2>
      <p>
        Revisit earlier editions using the links above, or find a recording in Resources.
      </p>
      {!hasCycles && <SessionsNav active={current ? "all" : undefined} />}
      <a class="recordings-link" href="/resources/#videos"
        >Browse recordings <span aria-hidden="true">↗</span></a
      >
    </aside>
  </main>
  <Footer />
</Layout>

<script>
  function setupProgrammeBrowser() {
    document.querySelectorAll<HTMLElement>('[data-cycle-browser="true"]').forEach(root => {
      if (root.dataset.browserReady) return;
      root.dataset.browserReady = "true";
      const cycle = root.querySelector<HTMLSelectElement>("[data-cycle-filter]")!;
      const format = root.querySelector<HTMLSelectElement>("[data-format-filter]")!;
      const reset = root.querySelector<HTMLButtonElement>("[data-reset-filters]")!;
      const status = root.querySelector<HTMLElement>(".filter-status")!;
      const empty = root.querySelector<HTMLElement>(".filter-empty")!;
      const groups = root.querySelectorAll<HTMLElement>(".archive-group");
      const update = () => {
        let count = 0;
        groups.forEach(group => {
          let visible = 0;
          group.querySelectorAll<HTMLElement>("[data-session-formats]").forEach(row => {
            row.hidden = (cycle.value !== "all" && cycle.value !== group.dataset.cycle)
              || (format.value !== "all" && !row.dataset.sessionFormats?.split(" ").includes(format.value));
            if (!row.hidden) visible++;
          });
          group.hidden = visible === 0;
          group.querySelector<HTMLElement>(".group-count")!.textContent = `${visible} ${visible === 1 ? "session" : "sessions"}`;
          count += visible;
        });
        status.textContent = `${count} ${count === 1 ? "session" : "sessions"} shown`;
        status.hidden = false;
        empty.hidden = count !== 0;
        reset.hidden = cycle.value === "all" && format.value === "all";
      };
      cycle.addEventListener("change", update);
      format.addEventListener("change", update);
      reset.addEventListener("click", () => {
        cycle.value = "all";
        format.value = "all";
        update();
        cycle.focus();
      });
      root.querySelector<HTMLElement>(".programme-filters")!.hidden = false;
      update();
    });
  }
  setupProgrammeBrowser();
  document.addEventListener("astro:page-load", setupProgrammeBrowser);
</script>

<style>
  [hidden] { display: none !important; }
  .programme-browser { margin-bottom: 2rem; }
  .programme-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 1rem;
    font-family: "Work Sans", sans-serif;
  }
  .programme-filters label { display: flex; flex-direction: column; gap: 0.5rem; flex: 1 1 220px; min-width: 0; }
  .programme-filters label > span { font-size: 0.75rem; font-weight: 600; }
  .programme-filters select {
    width: 100%;
    min-width: 0;
    padding: 0.7rem;
    border: 1px solid rgba(var(--color-border), 0.85);
    border-radius: 0.5rem;
    background: rgb(var(--color-fill));
    color: rgb(var(--color-text-base));
    font-size: 0.875rem;
  }
  .programme-filters select:focus-visible, .programme-filters button:focus-visible {
    outline: 2px solid rgb(var(--color-accent)); outline-offset: 3px;
  }
  .programme-filters button { padding: 0.7rem 0; font-size: 0.8rem; text-decoration: underline; text-underline-offset: 0.2em; }
  .filter-status, .filter-empty { font-family: "Work Sans", sans-serif; font-size: 0.8rem; line-height: 1.6; margin: 1rem 0 0; opacity: 0.8; }
  .sessions-page {
    width: 100%;
    max-width: 960px;
    margin: 0 auto;
    padding: 0 1.5rem 3rem;
  }
  .archive-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-bottom: 1.75rem;
    font-family: "Work Sans", sans-serif;
    font-size: 0.8rem;
  }
  .archive-breadcrumb a,
  .archive-breadcrumb > span {
    opacity: 0.7;
  }
  .archive-breadcrumb a:hover {
    opacity: 1;
    text-decoration: underline;
  }
  .page-heading {
    margin-bottom: 1.5rem;
  }
  .eyebrow {
    font-family: "Work Sans", sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.65rem;
    font-weight: 600;
    margin: 0 0 0.6rem;
    color: rgb(var(--color-accent));
  }
  h1 {
    font-size: clamp(2.75rem, 7vw, 4.25rem);
    font-weight: 600;
    line-height: 1.05;
    margin: 0 0 1rem;
  }
  .page-introduction,
  .edition-introduction,
  .group-introduction,
  .cross-edition > p {
    font-family: "Work Sans", sans-serif;
    line-height: 1.65;
    opacity: 0.85;
    max-width: 68ch;
  }
  .page-introduction {
    font-size: 1rem;
    margin: 0;
  }
  .edition-nav {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.65rem;
    margin: 0 0 2.5rem;
  }
  .edition-link {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1rem;
    border: 1px solid rgba(var(--color-border), 0.9);
    border-radius: 0.65rem;
    text-decoration: none;
  }
  .edition-link:hover {
    border-color: rgb(var(--color-accent));
    background: rgba(var(--color-card-muted), 0.15);
  }
  .edition-link.selected {
    border-color: rgb(var(--color-accent));
    background: rgba(var(--color-card-muted), 0.32);
    box-shadow: inset 0 -3px rgb(var(--color-accent));
  }
  .edition-link:focus-visible,
  .group-nav a:focus-visible,
  .recordings-link:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 4px;
  }
  .edition-link-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem;
    font-size: 1.3rem;
  }
  .edition-link-top > span {
    color: rgb(var(--color-accent));
    font-family: "Work Sans", sans-serif;
    font-size: 1rem;
  }
  .edition-years,
  .edition-count {
    font-family: "Work Sans", sans-serif;
  }
  .edition-years {
    font-size: 0.875rem;
  }
  .edition-count {
    font-size: 0.7rem;
    opacity: 0.75;
    margin-top: 0.35rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.7rem;
  }
  .current-label {
    font-weight: 600;
  }
  .edition-heading {
    margin-bottom: 1.5rem;
  }
  h2 {
    font-size: clamp(1.9rem, 4vw, 2.65rem);
    font-weight: 600;
    line-height: 1.2;
    margin: 0 0 1rem;
  }
  h2 > span {
    font-size: 0.7em;
    font-weight: 400;
    opacity: 0.65;
    white-space: nowrap;
  }
  .edition-introduction {
    margin: 0 0 0.8rem;
    font-size: 1rem;
  }
  .edition-summary {
    font-family: "Work Sans", sans-serif;
    font-size: 0.75rem;
    line-height: 1.75;
    opacity: 0.65;
    margin: 0;
  }
  .edition-summary > span {
    margin: 0 0.4rem;
  }
  .group-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-bottom: 2.5rem;
  }
  .group-nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: "Work Sans", sans-serif;
    font-size: 0.8rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid rgba(var(--color-border), 0.8);
    border-radius: 2rem;
  }
  .group-nav a:hover {
    background: rgba(var(--color-card-muted), 0.2);
  }
  .group-nav span {
    font-size: 0.7rem;
    opacity: 0.65;
  }
  .edition-groups {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }
  .archive-group {
    width: 100%;
    max-width: none;
    scroll-margin-top: 1.5rem;
    margin: 0;
  }
  .group-heading {
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    align-items: center;
  }
  h3 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 600;
    line-height: 1.2;
    margin: 0;
  }
  .group-count {
    font-family: "Work Sans", sans-serif;
    font-size: 0.75rem;
    opacity: 0.65;
    flex-shrink: 0;
  }
  .group-introduction {
    margin: 0.9rem 0 1.5rem;
    font-size: 0.875rem;
  }
  .session-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .cross-edition {
    border-top: 1px solid rgba(var(--color-border), 0.85);
    padding-top: 2rem;
    margin-top: 3.5rem;
  }
  .cross-edition h2 {
    font-size: 1.5rem;
    margin-bottom: 0.8rem;
  }
  .cross-edition > p {
    font-size: 0.875rem;
    margin: 0 0 1.25rem;
  }
  .cross-edition :global(nav) {
    margin-bottom: 1rem;
    gap: 0.55rem;
  }
  .cross-edition :global(nav a) {
    font-family: "Work Sans", sans-serif;
    font-size: 0.75rem;
    padding: 0.5rem 0.8rem;
  }
  .recordings-link {
    font-family: "Work Sans", sans-serif;
    font-size: 0.8rem;
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }
  @media (max-width: 639px) {
    .sessions-page {
      padding: 0 1rem 2rem;
    }
    .archive-breadcrumb {
      margin-bottom: 1.75rem;
    }
    .edition-nav {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin-bottom: 2.5rem;
    }
    .edition-link {
      padding: 0.8rem;
    }
    .edition-link-top {
      font-size: 1.2rem;
    }
    .group-heading {
      align-items: flex-start;
    }
    .group-count {
      padding-top: 1.3rem;
    }
    .edition-groups {
      gap: 2.5rem;
    }
  }
</style>
