---
import SubscriptionReassurance from './SubscriptionReassurance.astro';
import { getContactRevision } from '@utils/contactRevision';
import subscription from '../../subscription/config.json';
interface Props { id: string; forwardToFooter?: boolean; unsubscribe?: boolean; compact?: boolean; nameField?: boolean; nameLabel?: string; reassurance?: string; hideEmailLabel?: boolean; emailPlaceholder?: string }
const { id, forwardToFooter = false, unsubscribe = false, hideEmailLabel = false, emailPlaceholder = 'you@example.com', compact = false, nameField = true, nameLabel = 'Name', reassurance = 'Only when we have something to share. Unsubscribe anytime.' } = Astro.props;
const revision = getContactRevision(Astro.url, Astro.locals);
const ready = subscription.enabled && Boolean(subscription.endpoint && subscription.turnstileSiteKey);
---
<ai-phi-subscription data-forward-to-footer={String(forwardToFooter)} data-operation={unsubscribe ? 'unsubscribe' : 'subscription'} data-endpoint={ready && !forwardToFooter ? (unsubscribe ? subscription.endpoint.replace(/\/subscribe$/, '/unsubscribe') : subscription.endpoint) : ''} data-sitekey={ready && !forwardToFooter ? subscription.turnstileSiteKey : ''} class:list={['signup-form', { compact, 'email-only': forwardToFooter || unsubscribe || (!nameField && !revision), 'named-signup': Boolean(revision) && !unsubscribe && !forwardToFooter }]}>
  <form aria-label={unsubscribe ? "Unsubscribe from ai-phi email updates" : "Subscribe to ai-phi email updates"}>
    <div class="fields">
      {revision && !unsubscribe && !forwardToFooter && <>
        <label for={`${id}-first-name`}><span class="field-title">First name *</span><input id={`${id}-first-name`} name="firstName" type="text" autocomplete="given-name" placeholder="First name" maxlength="100" required /></label>
        <label for={`${id}-last-name`}><span class="field-title">Last name *</span><input id={`${id}-last-name`} name="lastName" type="text" autocomplete="family-name" placeholder="Last name" maxlength="100" required /></label>
      </>}
      {nameField && !revision && !unsubscribe && !forwardToFooter && <label for={`${id}-name`}><span class="field-title">{nameLabel} <span>(optional)</span></span>
        <input id={`${id}-name`} name="name" type="text" autocomplete="given-name" placeholder="Your name" maxlength="100" />
      </label>}
      <label for={`${id}-email`}><span class:list={["field-title", { "visually-hidden": hideEmailLabel }]}>Email{revision ? " *" : ""}</span>
        <input id={`${id}-email`} name="email" type="email" autocomplete="email" placeholder={emailPlaceholder} required maxlength="254" />
      </label>
      <button type="submit" aria-label={forwardToFooter ? "Continue subscribing in the footer" : undefined} disabled>{unsubscribe ? "Unsubscribe" : "Subscribe"} <span aria-hidden="true">↗</span></button>
    </div>
    {reassurance && <p class="reassurance"><SubscriptionReassurance text={reassurance} /></p>}
    {!forwardToFooter && <>
      <div class="signup-trap" aria-hidden="true"><label>Leave empty<input name="website" tabindex="-1" autocomplete="off" /></label></div>
      <div data-challenge></div>
    </>}
    <p data-status role="status" aria-live="polite">{!ready ? 'Email signup opens shortly. Please check back soon.' : ''}</p>
  </form>
  <div class="result" role="status" aria-live="polite" tabindex="-1" hidden>
    <p class="success-title">{unsubscribe ? 'Unsubscribe request completed.' : 'You’re on the list.'}</p>
    <p>{unsubscribe ? "If this address was subscribed to ai-phi updates, it will no longer receive them." : "You’ll hear about upcoming sessions and community news."}</p>
  </div>
  <noscript>Please enable JavaScript to use this form.</noscript>
</ai-phi-subscription>

<style>
  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  [hidden] { display: none !important; }
  [data-status]:empty { display: none; }
  [data-status] { margin-top: .75rem; font-size: .85rem; line-height: 1.5; }
  .signup-trap { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .signup-form { display: block; font-family: 'Work Sans', sans-serif; }
  .fields { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: 1rem; align-items: end; }
  label { display: grid; gap: .45rem; font-size: .85rem; font-weight: 600; }
  .field-title { font-weight: 600; }
  .field-title span { font-weight: 400; opacity: .7; }
  input { width: 100%; min-width: 0; border: 1px solid var(--signup-border, #b9b2a4); background: var(--signup-input, #fffdf8); color: var(--signup-ink, #272a23); border-radius: .45rem; padding: .8rem .9rem; font: inherit; font-size: 16px; font-weight: 400; }
  input::placeholder { color: var(--signup-muted, #67695f); opacity: 1; }
  button[type='submit'] { grid-column: 1 / -1; display: flex; align-items: center; justify-content: space-between; gap: 1rem; border-radius: .45rem; min-height: 48px; padding: .75rem 1.1rem; background: var(--signup-button, #303a2f); color: var(--signup-button-text, #fffdf8); font-weight: 600; }
  button:hover { filter: brightness(1.15); }
  button:disabled { opacity: .55; cursor: wait; }
  :is(input, button):focus-visible { outline: 2px solid var(--signup-ink, #272a23); outline-offset: 4px; }
  .reassurance { margin-top: .85rem; color: var(--signup-muted, #67695f); font-size: .76rem; line-height: 1.6; }
  .result { padding: .75rem 0; line-height: 1.65; }
  .success-title { font-family: 'Velvelyne', serif; font-size: 1.8rem; margin-bottom: .5rem; }
  .compact .fields { grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr) auto; }
  .compact button[type='submit'] { grid-column: auto; }
  .compact.email-only .fields { grid-template-columns: minmax(0, 1fr) auto; }
  @media (max-width: 620px) { .fields, .compact .fields, .compact.email-only .fields { grid-template-columns: 1fr; } .compact button[type='submit'] { grid-column: 1 / -1; } }
</style>

<script>
  import './client';
</script>
